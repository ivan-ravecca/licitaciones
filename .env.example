# Claude AI
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=alerts@your-domain.com
EMAIL_TO=you@example.com

# App settings
NODE_ENV=development
PORT=3000
# Cron expression for 5:00 PM Uruguay time (Monday-Friday)
CRON_SCHEDULE=0 17 * * 1-5
# Days to look back when fetching RSS (default 1 = today only)
FETCH_DAYS_BACK=1
# Maximum department ID to iterate (inclusive)
DEPARTMENT_ID_MAX=30
# Comma-separated department IDs to include (overrides range if set)
# DEPARTMENT_IDS=1,2,5,8

# Security token for manual /run trigger (recommended in production)
TRIGGER_TOKEN=replace-with-strong-random-token
