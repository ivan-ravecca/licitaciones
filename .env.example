# Claude AI
ANTHROPIC_API_KEY=your-anthropic-api-key

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=licitaciones@example.com
EMAIL_TO=you@example.com

# App settings
# Cron expression for 8:30 AM Uruguay time (UTC-3)
CRON_SCHEDULE=30 11 * * *
# Days to look back when fetching RSS (default 1 = today only)
FETCH_DAYS_BACK=1
# Maximum department ID to iterate (inclusive)
DEPARTMENT_ID_MAX=30
# Comma-separated department IDs to include (overrides range if set)
# DEPARTMENT_IDS=1,2,5,8
